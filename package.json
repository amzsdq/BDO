{
  "name": "bdo-life-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "data:import": "node scripts/import-scoped-bdo-extractor.mjs",
    "data:icons": "node scripts/install-icon-assets.mjs",
    "data:substitution-group-ids": "node scripts/codex-material-group-ids.mjs",
    "data:collect-substitutions": "node scripts/collect-codex-substitution-groups.mjs",
    "data:collect-referenced-substitutions": "node scripts/collect-substitution-evidence-from-recipes.mjs",
    "data:substitutions": "node scripts/apply-substitution-evidence.mjs",
    "data:validate": "node scripts/validate-dataset.mjs",
    "data:reconcile": "node scripts/reconcile-codex.mjs",
    "data:promote": "node scripts/promote-release-dataset.mjs",
    "data:release-gate": "node scripts/assert-release-dataset.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
