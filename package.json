{
  "name": "bdo-life-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run test:release-evidence && npm run build && npm run e2e:harness",
    "test:release-evidence": "node scripts/bootstrap-production-data.regression.mjs && node scripts/collect-codex-item-evidence.regression.mjs && node scripts/collect-codex-recipe-details.regression.mjs && node scripts/assert-e2e-release-evidence.test.mjs && node scripts/release-e2e-bindings.test.mjs && node --check scripts/bind-codex-detail-evidence.mjs",
    "e2e:release-evidence": "node scripts/assert-e2e-release-evidence.mjs",
    "e2e:harness": "node scripts/assert-e2e-harness.mjs",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "data:import": "node scripts/import-scoped-bdo-extractor.mjs",
    "data:names-ko": "node scripts/apply-korean-name-evidence.mjs",
    "data:yields": "node scripts/apply-yield-evidence.mjs",
    "data:icons": "node scripts/install-icon-assets.mjs",
    "data:mastery-evidence": "node scripts/prepare-mastery-evidence.mjs",
    "data:validate": "node scripts/validate-dataset.mjs",
    "data:reconcile": "node scripts/reconcile-codex.mjs",
    "data:promote": "node scripts/promote-production-dataset.mjs",
    "data:release-gate": "node scripts/assert-production-release.mjs",
    "data:codex:browser": "node scripts/collect-codex-catalog-browser.mjs",
    "data:codex:items": "node scripts/collect-codex-item-evidence.mjs",
    "data:codex:groups": "node scripts/collect-codex-substitution-groups.mjs",
    "data:codex:details": "node scripts/collect-codex-recipe-details.mjs",
    "data:codex:bind": "node scripts/bind-codex-detail-evidence.mjs",
    "data:codex:normalize-random": "node scripts/normalize-codex-random-output-aliases.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
