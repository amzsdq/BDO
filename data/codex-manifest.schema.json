{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDO Codex reconciliation manifest",
  "type": "object",
  "required": ["generatedAt", "recipes"],
  "properties": {
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recipeId", "skill", "titleKo", "available", "ingredients"],
        "properties": {
          "recipeId": { "type": ["integer", "string"], "description": "BDO Codex page id; provenance only, not canonical recipe identity" },
          "outputItemId": { "type": "integer", "minimum": 0, "description": "Linked canonical BDO output item id when available; preferred reconciliation identity" },
          "skill": { "enum": ["cooking", "alchemy"] },
          "titleKo": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" },
          "url": { "type": "string" },
          "baseYield": {
            "type": "object",
            "properties": {
              "min": { "type": "number", "exclusiveMinimum": 0 },
              "max": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "count"],
              "properties": {
                "itemId": { "type": "integer", "minimum": 0, "description": "Linked canonical BDO ingredient item id when available; preferred over name matching" },
                "name": { "type": "string", "minLength": 1 },
                "count": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
